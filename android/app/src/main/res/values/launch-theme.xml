<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black from the first frame: Theme.Material's grey window showed on every
         launch before the menu artwork drew. -->
    <style name="PaperLaunchTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
